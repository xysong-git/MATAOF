{
  "knowledge_store": "data/knowledge_pipeline_llm.db",
  "knowledge_backend": "sqlite",
  "results_dir": "results/round_pipeline_llm_dbs",
  "executor": {
    "type": "iotdb",
    "host": "127.0.0.1",
    "port": 6667,
    "user": "root",
    "password": "root",
    "fetch_size": 1024,
    "measure_baseline": false
  },
  "database_state": {
    "data_scale_level": "small"
  },
  "system_state": {},
  "candidate_strategies": null,
  "baseline_strategy": null,
  "thresholds": {},
  "reference_time": null,
  "knowledge_save_interval": 500,
  "async_drain_timeout": 0,
  "agents": {
    "enabled": true,
    "llm_shared": true,
    "control": "pipeline",
    "query_analysis": {
      "llm_policy": "on_gap",
      "confidence_threshold": 0.5,
      "deadline_ms": 10000
    },
    "optimization_decision": {
      "max_attempts": 2,
      "deadline_ms": 30000,
      "replan_on": [
        "degraded",
        "failed"
      ],
      "recall_on_empty_evidence": true,
      "recall_max_records": null
    },
    "execution_monitoring": {
      "llm_policy": "on_anomaly",
      "deadline_ms": 5000
    },
    "knowledge_memory": {
      "min_strong": 1,
      "max_rounds": 2,
      "expand_factor": 2,
      "deadline_ms": 2000
    }
  },
  "llm": {
    "provider": "openai",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key": "EMPTY",
    "model": "/opt/models/Qwen3-8B",
    "timeout_s": 180,
    "max_tokens": 1024,
    "log_file": "data/llm_log.jsonl",
    "extra_body": {
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "preference_bonus": false,
    "decision_mode": "llm_primary",
    "sample_rate": 1,
    "async_enhance": false,
    "async_workers": 2,
    "cache_file": "data/llm_cache_dbs.json"
  },
  "device_inventory_file": "data/device_inventory.json"
}